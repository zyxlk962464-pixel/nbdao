# 默认 BSC 只读：只读取与分叉模拟，不发送交易。
SELLER_MODE=read-only
RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed-public.bnbchain.org
FORK_RPC_URL=https://bsc-dataseed.bnbchain.org
WALLET_RPC_URL=https://bsc-dataseed.bnbchain.org
SELLER_ADDRESS=
EXECUTOR_ADDRESS=
# 只服务这个持币钱包；留空时实盘默认仅允许执行钱包同址。
ALLOWED_OWNER_ADDRESS=
# 私钥只放服务端；同持币钱包私钥会授予进程该钱包的完整签名能力。
KEEPER_PRIVATE_KEY=
LIVE_EXECUTION=
DEPLOYMENT_BLOCK=
DEPENDENCY_BASELINE=docs/evidence/chain-check.json
# 独立 Chainlink 风格价格源，合约 description 需为 BNB/USDT 或 BNB/USD。
BNB_USDT_ORACLE=
# 主价格源若为 BNB/USD，必须提供 USDT/USD feed，缺失停止净额优化。
USDT_USD_ORACLE=
ORACLE_MAX_AGE_SECONDS=3600
KEEPER_DATABASE=data/keeper.sqlite
# 云端先只读导入，再确认本机 Keeper 已停止后启用实盘。
KEEPER_IMPORT_FILE=
EXECUTION_HANDOFF=
KEEPER_HOST=127.0.0.1
KEEPER_PORT=8787
# 只轮询最新区块号；同一区块不重复执行监控，忙碌时合并到最新块。
KEEPER_POLL_MS=500
QUOTE_TIMEOUT_MS=90000
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# 钱包公共配置（只允许这些 NEXT_PUBLIC 字段进入网页，不放任何私钥）。
# WalletConnect Project ID 为本人 Reown 项目生成的 32 位十六进制公开 ID。
# 留空使用当前网页地址；填写时需与实际访问网址一致。
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
# 本地测试：pnpm demo 后 SELLER_MODE=local RPC_URLS=http://127.0.0.1:8545
# 本地只使用公开 Anvil 测试私钥与 Mock，不能用于 BSC。
