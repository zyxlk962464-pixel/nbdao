# 在 Railway Variables 中填写；这份文件只有公开配置，不含私钥。
SELLER_MODE=read-only
LIVE_EXECUTION=
EXECUTION_HANDOFF=
SELLER_ADDRESS=0xd072DF01c890695df38C42d5805E951a1b3dE07b
# /opening/deploy 完成并核对新合约后填写，不替换旧 SELLER_ADDRESS。
OPENING_SELLER_ADDRESS=
DEPLOYMENT_BLOCK=126662619
EXECUTOR_ADDRESS=0x311349ab245f51eb2B97E9b85B2fa0bbd20211DD
ALLOWED_OWNER_ADDRESS=0x311349ab245f51eb2B97E9b85B2fa0bbd20211DD
KEEPER_PRIVATE_KEY=
RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed-public.bnbchain.org
WALLET_RPC_URL=https://bsc-dataseed.bnbchain.org
BNB_USDT_ORACLE=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
USDT_USD_ORACLE=0xB97Ad0E74fa7d920791E90258A6E2085088b4320
ORACLE_MAX_AGE_SECONDS=3600
DEPENDENCY_BASELINE=docs/evidence/chain-check.json
# 在 Railway 挂载 /data；固定单实例，关闭 Serverless/App Sleeping。
KEEPER_DATABASE=/data/keeper.sqlite
KEEPER_IMPORT_FILE=
KEEPER_HOST=127.0.0.1
KEEPER_PORT=8787
KEEPER_POLL_MS=500
QUOTE_TIMEOUT_MS=90000
# 以下为可选公开构建变量，调整后需要重新构建。
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
